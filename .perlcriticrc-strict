# .perlcriticrc-strict — Ásbrú Plus
#
# Strict profile applied to NEW modules under lib/PAC/* and lib/PACSshConfig.pm.
# Severity 3 catches buggy patterns the relaxed profile lets through:
#   - missing return values
#   - implicit list context
#   - chained string ops without quoting
#
# As the rest of the codebase migrates into lib/PAC/*, it is automatically
# subject to this stricter profile.

severity = 3
verbose  = 9

# Same exemptions as the relaxed profile — these are stylistic, not buggy:
[-Subroutines::ProhibitSubroutinePrototypes]
[-ControlStructures::ProhibitPostfixControls]
[-Modules::ProhibitMultiplePackages]
[-NamingConventions::Capitalization]
[-Subroutines::RequireFinalReturn]
[-ValuesAndExpressions::ProhibitMagicNumbers]
[-Variables::ProhibitPunctuationVars]
[-References::ProhibitDoubleSigils]
[-InputOutput::RequireBriefOpen]
[-CodeLayout::RequireTidyCode]
[-Documentation::RequirePodSections]
[-Documentation::RequirePodAtEnd]

# Legacy style inherited from a 15-year-old upstream that carries no critic
# standard of its own. These are stylistic, not bugs; enforcing them would
# rewrite hundreds of untouched lines for no correctness gain.
[-RegularExpressions::RequireExtendedFormatting]
[-RegularExpressions::ProhibitComplexRegexes]
[-ControlStructures::ProhibitNegativeExpressionsInUnlessAndUntilConditions]
[-ControlStructures::ProhibitCascadingIfElse]
[-NamingConventions::ProhibitAmbiguousNames]
[-ValuesAndExpressions::ProhibitImplicitNewlines]
[-ValuesAndExpressions::ProhibitQuotesAsQuotelikeOperatorDelimiters]
[-ValuesAndExpressions::ProhibitConstantPragma]
[-Subroutines::ProhibitManyArgs]

# Architectural, not accidental: the `_`-prefixed cross-package helpers and the
# %PACMain::FUNCS-style package globals are the deliberate goto-proxy API this
# fork is built on. ProtectPrivate*/PackageVars/UnusedPrivate/ArgUnpacking all
# fight that design (arg-unpacking in particular breaks `goto &proxy`).
[-Subroutines::ProtectPrivateSubs]
[-Variables::ProtectPrivateVars]
[-Subroutines::ProhibitUnusedPrivateSubroutines]
[-Variables::ProhibitPackageVars]
[-Subroutines::RequireArgUnpacking]

# Best-effort GUI/cleanup evals (theme reload, widget destroy, style refresh)
# intentionally swallow failures; the correctness-critical sites (crypto verify,
# YAML/Storable load) check $@ explicitly.
[-ErrorHandling::RequireCheckingReturnValueOfEval]

# Symbol-table / typeglob work legitimately needs scoped strictness relaxation.
[-TestingAndDebugging::ProhibitNoStrict]
[-TestingAndDebugging::ProhibitNoWarnings]
[-TestingAndDebugging::ProhibitProlongedStrictureOverride]

# Allow our long _wakeOnLan-style dialog functions; complexity is acknowledged.
[Subroutines::ProhibitExcessComplexity]
max_mccabe = 50

# Same hard lines as the relaxed profile.
[BuiltinFunctions::ProhibitStringyEval]
[InputOutput::ProhibitBacktickOperators]
severity = 4
[InputOutput::ProhibitTwoArgOpen]
[InputOutput::ProhibitBarewordFileHandles]
[Subroutines::ProhibitBuiltinHomonyms]
[Variables::ProhibitConditionalDeclarations]
[Variables::ProhibitLocalVars]
severity = 4
